# Firebase web app settings (Firebase console → Project settings → Your apps).
# Without these the site still works; the enquiry form shows Call/WhatsApp instead.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Firebase App Check with reCAPTCHA Enterprise (skipped on the emulator).
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Local development against the Firestore + Auth emulators (`npm run emulators`, then `npm run dev:emulator`).
# The project id defaults to demo-udan, and no real config is needed.
VITE_USE_EMULATOR=
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
VITE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Firestore database ID when not "(default)" (e.g. an Enterprise DB named "default").
VITE_FIRESTORE_DATABASE_ID=
