{
  "name": "udan",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "VITE_USE_EMULATOR=true vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "node scripts/with-java.mjs firebase emulators:exec --only firestore,auth --project demo-udan \"vitest run\"",
    "test:watch": "vitest",
    "emulators": "node scripts/with-java.mjs firebase emulators:start --only firestore,auth --project demo-udan"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@react-pdf/renderer": "4.9.0",
    "firebase": "^12.5.0",
    "lucide-react": "^1.61.0",
    "qrcode": "1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-is": "19.3.1",
    "react-router": "^7.18.4",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "firebase-tools": "^15.34.2",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.5"
  }
}
